# ═══════════════════════════════════════════════════════════════════════════════
# Airbrake Python Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to .env for local development. In Lambda, set these in:
#   Lambda → Configuration → Environment variables
#
# NEVER commit .env files containing real secrets.

# ── Application Environment ───────────────────────────────────────────────────
# Controls security behavior:
#   production  → Secure cookies, dev tokens rejected, strict CORS
#   development → Non-secure cookies, dev tokens allowed (with DEV_AUTH=1)
APP_ENV=development

# ── Aurora DSQL ───────────────────────────────────────────────────────────────
DSQL_ENDPOINT=ezt2bkam5s4kjre73r25easkcu.dsql.us-east-1.on.aws
DSQL_REGION=us-east-1

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Where to redirect after login. Must match ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:3000

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
# Comma-separated list of origins permitted for credentialed requests.
# In production, set to the actual frontend domain(s) only.
ALLOWED_ORIGINS=http://localhost:3000

# ── Local Authentication ──────────────────────────────────────────────────────
# Authentication uses a bundled auth/users.json file — no external provider.
# To change credentials, update users.json with a new Werkzeug password hash:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('newpassword'))"
# No environment variables are required for authentication.

# ── Development Authentication ────────────────────────────────────────────────
# Enables dev-token-admin / dev-token-developer / dev-token-viewer for local dev.
# NEVER set in production — rejected if APP_ENV=production.
DEV_AUTH=1

# ── Atlassian OAuth 2.0 (Jira Integration) ────────────────────────────────────
# Get these from: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your-oauth-client-id
ATLASSIAN_CLIENT_SECRET=your-oauth-client-secret
ATLASSIAN_CALLBACK_URL=http://localhost:5000/api/jira/callback
ATLASSIAN_OAUTH_SCOPES=read:me read:account read:jira-user read:jira-work write:jira-work

# ── Jira Webhook (optional) ───────────────────────────────────────────────────
# Shared secret for Jira webhook verification. Set in Jira webhook config too.
JIRA_WEBHOOK_SECRET=

# ── Teams Webhook (optional) ──────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=
