# ── Aurora DSQL ───────────────────────────────────────────────────────────────
# Set these in Lambda → Configuration → Environment variables
DSQL_ENDPOINT=ezt2bkam5s4kjre73r25easkcu.dsql.us-east-1.on.aws
DSQL_REGION=us-east-1

# ── Server (local dev only — not used in Lambda) ──────────────────────────────
PORT=3001

# ── Teams webhook (optional) ──────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...

# ── Jira (optional) ───────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-jira-instance.atlassian.net
JIRA_PROJECT_KEY=AI
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# ── Atlassian OAuth 2.0 (for Jira integration) ────────────────────────────────
# Get these from: https://developer.atlassian.com/console/myapps/
ATLASSIAN_CLIENT_ID=your-oauth-client-id
ATLASSIAN_CLIENT_SECRET=your-oauth-client-secret
ATLASSIAN_CALLBACK_URL=http://localhost:5000/api/jira/callback

# OAuth scopes (space-separated, optional - uses sensible defaults if not set)
# Required scopes for issue search and creation:
#   read:me read:account read:jira-user read:jira-work write:jira-work
# Granular scopes (optional):
#   read:issue:jira read:project:jira read:jql:jira read:user:jira
#   read:field:jira read:comment:jira read:attachment:jira write:issue:jira
ATLASSIAN_OAUTH_SCOPES=read:me read:account read:jira-user read:jira-work write:jira-work
